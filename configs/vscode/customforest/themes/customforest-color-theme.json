{
  "name": "CustomForest",
  "type": "light",
  "colors": {
    "editor.background": "#dfe4cd",
    "editor.foreground": "#5a5d5a",
    "editor.selectionBackground": "#c4ccae",
    "editor.lineHighlightBackground": "#d6dfbf",
    "editorCursor.foreground": "#7f8f8a",
    "editorLineNumber.foreground": "#9a9d97",
    "editorLineNumber.activeForeground": "#474b48",
    "editorWhitespace.foreground": "#c4ccae",
    "editorIndentGuide.background1": "#cdd4bb",
    "sideBar.background": "#d6dfbf",
    "sideBar.foreground": "#474b48",
    "activityBar.background": "#cdd4bb",
    "activityBar.foreground": "#474b48",
    "activityBarBadge.background": "#7f8f8a",
    "activityBarBadge.foreground": "#dfe4cd",
    "titleBar.activeBackground": "#cdd4bb",
    "titleBar.activeForeground": "#474b48",
    "statusBar.background": "#7f8f8a",
    "statusBar.foreground": "#dfe4cd",
    "tab.activeBackground": "#dfe4cd",
    "tab.activeForeground": "#474b48",
    "tab.inactiveBackground": "#cdd4bb",
    "tab.inactiveForeground": "#5a5d5a",
    "editorGroupHeader.tabsBackground": "#cdd4bb",
    "panel.background": "#dfe4cd",
    "terminal.background": "#dfe4cd",
    "terminal.foreground": "#5a5d5a",
    "terminal.ansiRed": "#b65045",
    "terminal.ansiGreen": "#7f8f8a",
    "terminal.ansiBlue": "#435a69",
    "terminal.ansiMagenta": "#8f899f",
    "button.background": "#7f8f8a",
    "button.foreground": "#dfe4cd",
    "focusBorder": "#7f8f8a",
    "list.activeSelectionBackground": "#c4ccae",
    "list.hoverBackground": "#d6dfbf"
  },
  "tokenColors": [
    { "scope": ["comment"], "settings": { "foreground": "#9a9d97", "fontStyle": "italic" } },
    { "scope": ["string"], "settings": { "foreground": "#5f7a5a" } },
    { "scope": ["constant.numeric", "constant.language"], "settings": { "foreground": "#a67c3d" } },
    { "scope": ["keyword", "storage"], "settings": { "foreground": "#8f899f" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#435a69" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type"], "settings": { "foreground": "#2f4858" } },
    { "scope": ["invalid"], "settings": { "foreground": "#b65045" } }
  ]
}
